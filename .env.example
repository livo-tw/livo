# =============================================
# LIVO frontend settings (Vite)
# Copy to .env.development (npm run dev), .env.production (vite build),
# or .env.localdb (vite build --mode localdb) and adjust.
# =============================================

# API origin of the Cloudflare Worker backend.
#   local development (cd worker && npm run dev): http://localhost:8787
#   production: your API origin, e.g. https://api.example.com
VITE_API_URL=http://localhost:8787

# false for a team deployment: sign-in checks that the account belongs to an
# active member, and people editing the same task field get edit locks.
# true skips both (fine for a single-person local trial).
VITE_LOCAL_MODE=false

# Optional. Link shown under System Admin → Edition. If you deploy a modified
# copy, point it at your own source (AGPL-3.0 §13).
# VITE_SOURCE_URL=https://github.com/your-name/livo
