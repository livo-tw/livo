# ============================================================
# LIVO 自架 Supabase - Docker 環境變數範本
# ============================================================
# 使用方式：
#   cp .env.example .env
#   然後逐一修改下方所有 <請修改> 標記的值
# ============================================================


############################################################
# 【必填】資料庫密碼
############################################################

# PostgreSQL 資料庫密碼
# 建議：使用 openssl rand -base64 32 產生強密碼
POSTGRES_PASSWORD=<請修改：至少16字元的強密碼>


############################################################
# 【必填】JWT 金鑰（三個值必須一起設定）
############################################################

# JWT 簽名密鑰（最少32字元）
# 產生方式：openssl rand -base64 40
JWT_SECRET=<請修改：至少32字元的隨機字串>

# JWT 有效期（秒），預設 3600 = 1 小時
JWT_EXPIRY=3600

# ANON_KEY - 匿名金鑰（前端公開金鑰）
# 這是一個用 JWT_SECRET 簽名的 JWT token
# 產生方式：見下方說明或使用 generate-keys.sh
ANON_KEY=<請修改：用 JWT_SECRET 簽名的 anon JWT>

# SERVICE_ROLE_KEY - 服務角色金鑰（後端私密金鑰，絕對不可暴露給前端）
# 產生方式：同上
SERVICE_ROLE_KEY=<請修改：用 JWT_SECRET 簽名的 service_role JWT>

# ── 如何產生 ANON_KEY 和 SERVICE_ROLE_KEY ──────────────────
# 可用以下 Node.js 腳本（或詢問 AI）：
#
# const jwt = require('jsonwebtoken')
#
# const anonPayload = {
#   role: 'anon', iss: 'supabase', iat: Math.floor(Date.now()/1000),
#   exp: Math.floor(Date.now()/1000) + (5 * 365 * 24 * 60 * 60)
# }
# const servicePayload = {
#   role: 'service_role', iss: 'supabase', iat: Math.floor(Date.now()/1000),
#   exp: Math.floor(Date.now()/1000) + (5 * 365 * 24 * 60 * 60)
# }
#
# console.log('ANON_KEY:', jwt.sign(anonPayload, 'YOUR_JWT_SECRET'))
# console.log('SERVICE_ROLE_KEY:', jwt.sign(servicePayload, 'YOUR_JWT_SECRET'))


############################################################
# 【必填】網址設定
############################################################

# 自架 Supabase API 的對外網址
# 本機測試用：http://localhost:8000
# 正式部署時改為你的域名：https://supabase.yourdomain.com
API_EXTERNAL_URL=http://localhost:8000

# 前端應用程式網址（Auth 信件中的連結會指向這裡）
# 本機測試用：http://localhost:5173
# 正式部署時改為你的域名：https://yourdomain.com
SITE_URL=http://localhost:5173

# 額外允許的 Auth 重導向網址（多個用逗號分隔）
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:3001


############################################################
# 【必填】Supabase Studio 管理後台帳密
############################################################

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<請修改：強密碼>

STUDIO_DEFAULT_ORGANIZATION=LIVO
STUDIO_DEFAULT_PROJECT=LIVO Project Management


############################################################
# 【必填】Realtime 密鑰
############################################################

# 產生方式：openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=<請修改：用 openssl rand -base64 64 產生>


############################################################
# 【選填】Email / SMTP 設定
# 不設定則無法收到驗證信、重設密碼信等
# 建議使用 Resend、SendGrid、Mailgun 等服務
############################################################

SMTP_ADMIN_EMAIL=noreply@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=<SMTP 帳號>
SMTP_PASS=<SMTP 密碼>
SMTP_SENDER_NAME=LIVO

# 是否自動確認 Email（true = 不需要驗證信，方便測試用）
# 正式環境建議改為 false
ENABLE_EMAIL_AUTOCONFIRM=true

# 是否關閉自行註冊（true = 只有管理員能新增成員）
# 建議設為 true，由管理員手動新增成員
DISABLE_SIGNUP=true

# Auth 郵件中的路徑（通常不需要修改）
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


############################################################
# 【選填】附件上傳上限
############################################################

# 單檔上傳上限（bytes），預設 200 MB = 209715200；不填也是 200 MB。
# 改完在 docker/ 目錄執行 docker compose up -d storage 生效。
# LIVO 網頁介面單檔上限固定 200 MB；調更高只對 API 上傳有效。
FILE_SIZE_LIMIT=209715200


############################################################
# 【選填】Slack 整合
# 不使用 Slack 通知功能可留空
############################################################

# Slack Bot Token（格式：xoxb-...）
SLACK_BOT_TOKEN=

# Slack Signing Secret
SLACK_SIGNING_SECRET=

# ── 設定 Slack Bot 步驟 ────────────────────────────────────
# 1. 前往 https://api.slack.com/apps 建立新 App
# 2. 開啟 Bot Token Scopes：channels:read, chat:write, im:write, users:read, users:read.email
# 3. 安裝到你的 Workspace，取得 Bot Token（xoxb-...）
# 4. 在 App 設定頁取得 Signing Secret
# 注意：自架後 slack-notify function 中的 APP_URL 和 GATEWAY_URL 需要更新
#       詳見 SELF_HOST_GUIDE.md


############################################################
# 【注意事項】
############################################################
# 1. 絕對不要把 .env 檔案提交到 Git！
# 2. SERVICE_ROLE_KEY 具有跳過 RLS 的超級權限，不可暴露給前端
# 3. 定期備份 ./volumes/db/data 目錄
# 4. 正式環境務必在 Kong 前面加 Nginx/Caddy 做 HTTPS 反向代理
