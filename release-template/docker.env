# LIVO self-host: factory env template shipped in the release zip.
# build-release.mjs copies this file to docker/.env.factory; the installer copies
# that to docker/.env on the first install only. Every secret below is a
# PUBLIC upstream Supabase placeholder; install.sh / install.bat replace all of
# them with per-install values on the first install (see installer/generate-keys.js).
# Never put a real secret in this file.
############################################################
# LIVO 自架 Supabase 配置
############################################################

# Postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT 金钥
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkwNTUzNjAwLCJleHAiOjIxMDYxNzI4MDB9.ESgs--IKwlzgXCsBOWL-uD50la0oxnYQ2M9rR_jX0YI
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTA1NTM2MDAsImV4cCI6MjEwNjE3MjgwMH0.WpK0aTR8IFhEHWDYPUlDJpjQXoofedR_zOd6wO65mo4

# Asymmetric keys (留空使用 legacy HS256)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# 网址
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:3001

# 前端對外基底網址（Slack 通知的任務連結等會用它組網址）。
# 預設是本機前端 http://localhost:3000（compose.frontend.yml 的預設埠；
# 若改了 LIVO_FRONTEND_PORT 請一併改這裡）。
# 架在正式網域時請改成實際網址，例如 https://pm.example.com（不含結尾斜線），
# 改完在 docker/ 目錄執行 docker compose up -d 重新載入。
APP_BASE_URL=http://localhost:3000

# Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Studio
STUDIO_DEFAULT_ORGANIZATION=LIVO
STUDIO_DEFAULT_PROJECT=LIVO Project Management
OPENAI_API_KEY=

# Realtime
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# Pooler (Supavisor)
VAULT_ENC_KEY=your-encryption-key-32-chars-min
POOLER_TENANT_ID=livo-local
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DB_POOL_SIZE=5

# pg-meta
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Analytics (Logflare)
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

SMTP_ADMIN_EMAIL=noreply@livo.local
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=LIVO
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Storage
# 單檔上傳上限（bytes），預設 200 MB = 209715200。
# 改完在 docker/ 目錄執行 docker compose up -d storage 生效。
# LIVO 網頁介面單檔上限固定 200 MB；調更高只對 API 上傳有效。
FILE_SIZE_LIMIT=209715200
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# imgproxy
IMGPROXY_AUTO_WEBP=true

# Functions
FUNCTIONS_VERIFY_JWT=false

# API / PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Kong
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Analytics / Docker
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=

# Optional Slack Socket Mode. Set the app-level token only after enabling the team switch.
SLACK_APP_TOKEN=
# Installer generates this private relay secret once; preserve it during upgrades.
SLACK_INTERNAL_SECRET=
