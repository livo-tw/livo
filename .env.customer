# Customer self-host build (`npx vite build --mode customer`).
# Connects to the self-hosted Docker Supabase stack in docker/.
#
# NOTE: the Supabase anon key below matches the JWT_SECRET in
# release-template/docker.env (shipped as docker/.env) — these are only FACTORY DEFAULTS. The customer installer
# (release-template/install.sh / installer/install.ps1) generates fresh
# per-install secrets at install time and string-replaces this anon key
# inside the built bundle (it locates the key by its stable base64url
# prefix eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiI).
# Keep this value in sync with release-template/docker.env so the pre-rotation bundle is
# still consistent for manual installs.
VITE_LOCAL_MODE=true
# Hides the demo-account hints on the login page (historical name; there
# are no license checks any more).
VITE_ENFORCE_LICENSE=true
# Blank the base .env's cloud API URL so this build uses the local Docker
# Supabase (client.ts picks the Supabase client only when VITE_API_URL is empty).
VITE_API_URL=
VITE_SUPABASE_PROJECT_ID=local
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkwNTUzNjAwLCJleHAiOjIxMDYxNzI4MDB9.ESgs--IKwlzgXCsBOWL-uD50la0oxnYQ2M9rR_jX0YI
